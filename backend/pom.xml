<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================
         PARENT: Spring Boot BOM (Bill of Materials)
         Gestiona las versiones de todas las dependencias
         automáticamente. Al heredar de aquí, no tenemos
         que especificar versiones en la mayoría de libs.
         =================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- ===================================================
         COORDENADAS DEL PROYECTO
         groupId: tu organización/proyecto
         artifactId: nombre del módulo
         version: versión actual (SNAPSHOT = en desarrollo)
         =================================================== -->
    <groupId>com.aac27</groupId>
    <artifactId>joyeria</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>AAC27 - Sistema de Gestión de Joyería</name>
    <description>Backend del sistema de gestión para la joyería AAC27. Desarrollado con Spring Boot 3.2 y Java 21.</description>
    <packaging>jar</packaging>

    <!-- ===================================================
         PROPIEDADES GLOBALES
         Centraliza versiones para facilitar actualizaciones
         =================================================== -->
    <properties>
        <!-- Java 21 (LTS): última versión con soporte a largo plazo -->
        <java.version>21</java.version>

        <!-- MapStruct: procesador que genera código de mapeo DTO <-> Entidad -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>

        <!-- Lombok: genera getters, setters, constructores automáticamente -->
        <lombok.version>1.18.32</lombok.version>

        <!-- JJWT: librería para crear y validar JSON Web Tokens -->
        <jjwt.version>0.12.5</jjwt.version>

        <!-- Encoding universal del proyecto -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- ===================================================
         DEPENDENCIAS
         Todo lo que el proyecto necesita para compilar
         y ejecutarse correctamente.
         =================================================== -->
    <dependencies>

        <!-- -----------------------------------------------
             NÚCLEO WEB
             Permite crear controladores REST (@RestController,
             @GetMapping, @PostMapping, etc.)
             Incluye Jackson para convertir objetos Java a JSON.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             SPRING SECURITY
             Motor de autenticación y autorización.
             Intercepta CADA petición HTTP y verifica permisos.
             Base del sistema JWT + RBAC del documento RF01-RF05.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             SPRING DATA JPA + HIBERNATE
             Permite trabajar con MySQL usando clases Java
             (@Entity, @Repository, JpaRepository).
             Hibernate es el motor ORM que traduce objetos a SQL.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             BEAN VALIDATION
             Activa @NotNull, @NotBlank, @Size, @Email, @Pattern
             en tus DTOs de request.
             Requerido por RNF-MAN04 y RNF-SEG05.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             SPRING BOOT ACTUATOR
             Endpoints de monitoreo y salud de la aplicación:
             /actuator/health  → ¿está viva la app?
             /actuator/metrics → métricas de rendimiento
             /actuator/info    → información del build
             Requerido por RNF-MAN07.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             DRIVER MYSQL
             Permite a Java conectarse a MySQL 8.
             Sin esto, la aplicación no puede acceder a la BD.
             scope=runtime: solo se necesita en ejecución,
             no en compilación.
             ----------------------------------------------- -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- -----------------------------------------------
             FLYWAY CORE
             Gestor de migraciones de base de datos.
             Al arrancar Spring Boot, Flyway aplica
             automáticamente los scripts SQL de:
             resources/db/migration/V1__xxx.sql
             Requerido por RNF-MAN06 y Sección 4.1.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             FLYWAY MYSQL
             Módulo específico de Flyway para MySQL 8.
             Sin esto, Flyway no reconoce la sintaxis MySQL.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- -----------------------------------------------
             JJWT - JSON Web Token (API)
             La interfaz pública para crear y parsear tokens JWT.
             Usamos tokens JWT para autenticación stateless (RF02).
             Estructura: Header.Payload.Signature
             ----------------------------------------------- -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <!-- -----------------------------------------------
             JJWT - Implementación
             La lógica real de creación/validación de tokens.
             scope=runtime: Spring lo carga automáticamente.
             ----------------------------------------------- -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- -----------------------------------------------
             JJWT - Jackson
             Integra JJWT con Jackson (el conversor JSON de Spring).
             Necesario para serializar/deserializar el payload JWT.
             ----------------------------------------------- -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- -----------------------------------------------
             MAPSTRUCT
             Genera código de conversión entre:
             - Entidad JPA → DTO de Respuesta
             - DTO de Request → Entidad JPA
             En tiempo de compilación (sin reflection = rápido).
             Requerido por Sección 4.1 DTOs.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- -----------------------------------------------
             LOMBOK
             Elimina código repetitivo con anotaciones:
             @Data          → getter + setter + equals + hashCode
             @Builder       → patrón Builder
             @NoArgsConstructor → constructor sin argumentos
             @AllArgsConstructor → constructor con todos los campos
             @Slf4j         → logger automático
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- -----------------------------------------------
             SPRING BOOT DEVTOOLS (solo desarrollo)
             Recarga automática al cambiar código.
             NO incluir en producción (scope=runtime, optional).
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- -----------------------------------------------
             SPRING BOOT TEST
             Marco de pruebas que incluye:
             - JUnit 5: framework de pruebas unitarias
             - Mockito: crear objetos "falsos" para aislar pruebas
             - AssertJ: assertions fluidas y legibles
             - MockMvc: simular peticiones HTTP sin levantar servidor
             Requerido por RNF-MAN01.
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- -----------------------------------------------
             SPRING SECURITY TEST
             Utilidades para probar endpoints protegidos:
             @WithMockUser → simula un usuario autenticado
             ----------------------------------------------- -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ===================================================
         PLUGINS DE BUILD
         Configuran cómo Maven compila y empaqueta el proyecto.
         =================================================== -->
    <build>
        <plugins>

            <!-- -----------------------------------------------
                 SPRING BOOT MAVEN PLUGIN
                 Genera el "fat JAR" ejecutable que incluye
                 todas las dependencias. Permite: mvn spring-boot:run
                 También excluye Lombok del JAR final (no se necesita
                 en runtime, solo en compilación).
                 ----------------------------------------------- -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- -----------------------------------------------
                 MAVEN COMPILER PLUGIN
                 Configura el compilador Java con:
                 - Java 21 (fuente y destino)
                 - Procesadores de anotaciones para Lombok y MapStruct
                 IMPORTANTE: El orden del annotationProcessorPaths
                 importa: Lombok ANTES de MapStruct para que
                 MapStruct vea los getters/setters generados por Lombok.
                 ----------------------------------------------- -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- 1ro: Lombok genera el código boilerplate -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- 2do: MapStruct usa ese código para generar los mappers -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- Activa el modo ComponentModel="spring" por defecto en MapStruct -->
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
